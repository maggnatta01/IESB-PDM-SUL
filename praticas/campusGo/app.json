{
  "expo": {
    "name": "campusGo",
    "slug": "campusGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "campusgo",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o CampusGo use sua localização para registrar o check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o CampusGo acesse suas fotos para escolher um avatar.",
          "cameraPermission": "Permita que o CampusGo use a câmera para tirar uma foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
